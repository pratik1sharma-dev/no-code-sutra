# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
MASTER_API_KEY=your-master-api-key-here-change-this-in-production

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# External API Keys (keep these secure)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret

# Application Configuration
ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=https://no-code-sutra.vercel.app,https://your-frontend-domain.com
FRONTEND_URL=https://no-code-sutra.vercel.app

# Railway Configuration
PORT=8000
PYTHONPATH=/app/backend

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=100
AUTH_RATE_LIMIT=10
WORKFLOW_RATE_LIMIT=50

# Security Configuration
ENABLE_CORS_CREDENTIALS=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# Logging Configuration
LOG_LEVEL=INFO
SECURITY_LOG_ENABLED=true
