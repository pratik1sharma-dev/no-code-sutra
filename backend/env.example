# LLM Provider Configuration
# Amazon Bedrock (Fastest & Most Reliable)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_here
AWS_DEFAULT_REGION=ap-southeast-1
BEDROCK_MODEL_ID=meta.llama3-1-8b-instruct-v1:0

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
MASTER_API_KEY=your-master-api-key-here-change-this-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
# Production (Railway/Platform Variable)
DATABASE_URL=${{ Postgres.DATABASE_URL }}
# Local Development
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nocodesutra
# Other cloud options:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# LangGraph Checkpointing (optional)
# CHECKPOINT_BACKEND=postgres   # options: memory|sqlite|postgres (default: memory)
# CHECKPOINT_POSTGRES_URL=${{ Postgres.DATABASE_URL }}
# CHECKPOINT_SQLITE_PATH=/workspace/.checkpoints/langgraph_checkpoints.sqlite

# Scheduler Configuration
SCHEDULER_BACKEND=apscheduler
APSCHEDULER_COALESCE=true
APSCHEDULER_MAX_INSTANCES=1
APSCHEDULER_MISFIRE_GRACE_TIME=300

# Future Celery Configuration (when scaling to distributed)
# SCHEDULER_BACKEND=celery
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# Cloudinary (for real Instagram posting image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Instagram Integration
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Instagram OAuth (for permanent token management)
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
INSTAGRAM_REDIRECT_URI=https://your-railway-domain.up.railway.app/api/auth/instagram/callback

# Application Configuration
ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=https://no-code-sutra.vercel.app,https://your-frontend-domain.com
FRONTEND_URL=https://no-code-sutra.vercel.app

# Railway Configuration
PORT=8000
PYTHONPATH=/app/backend

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=100
AUTH_RATE_LIMIT=10
WORKFLOW_RATE_LIMIT=50

# Security Configuration
ENABLE_CORS_CREDENTIALS=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# Logging Configuration
LOG_LEVEL=INFO
SECURITY_LOG_ENABLED=true

# Python Encoding Configuration (fixes Unicode text overlay issues)
PYTHONIOENCODING=utf-8
LC_ALL=en_US.UTF-8
LANG=en_US.UTF-8

# PIL/Pillow Font Encoding
PIL_FONT_ENCODING=utf-8

# External API Keys (keep these secure)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Dynamic Background Image APIs (Optional - for enhanced image selection)
# Unsplash (Free tier: 50 requests/hour) - https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
# Pexels (Free tier: 200 requests/hour) - https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here
# Pixabay (Free tier: 5000 requests/hour) - https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# Google Custom Search (Free tier: 100 queries/day) - https://developers.google.com/custom-search
GOOGLE_CUSTOM_SEARCH_API_KEY=your_google_api_key_here
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your_search_engine_id_here

# Canva API Integration (for template access and design creation)
CANVA_CLIENT_ID=your_canva_client_id_here
CANVA_CLIENT_SECRET=your_canva_client_secret_here
CANVA_REDIRECT_URI=http://127.0.0.1:8000/api/auth/canva/callback 