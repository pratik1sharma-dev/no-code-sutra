# LLM Provider Configuration
# Amazon Bedrock (Fastest & Most Reliable)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_here
AWS_DEFAULT_REGION=ap-southeast-1
BEDROCK_MODEL_ID=meta.llama3-1-8b-instruct-v1:0

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
# Local Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nocodesutra
# Supabase example (ensure sslmode=require)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Cloudinary (for real Instagram posting image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Instagram Access Token (for real posting)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Dynamic Background Image APIs (Optional - for enhanced image selection)
# Unsplash (Free tier: 50 requests/hour) - https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
# Pexels (Free tier: 200 requests/hour) - https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here
# Pixabay (Free tier: 5000 requests/hour) - https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here 