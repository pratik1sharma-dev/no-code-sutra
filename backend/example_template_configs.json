  "workflow_configurations": {
    "business_post_workflow": {
      "description": "Complete workflow for business Instagram posts",
      "nodes": [
        {
          "id": "ai_agent",
          "type": "aiAgent",
          "config": {
            "prompt": "Create professional business content about {{topic}} with headline, subhead, and 3 bullet points focusing on benefits and results"
          }
        },
        {
          "id": "image_generator",
          "type": "imageGenerator",
          "config": {
            "style": "professional business"
          }
        },
        {
          "id": "text_overlay",
          "type": "textOverlay",
          "config": {
            "use_instagram_template": true,
            "instagram_template_name": "minimal",
            "brand_config": {
              "colors": {
                "primary": [17, 24, 39, 255],
