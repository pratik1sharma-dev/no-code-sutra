# Local Development Environment
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Environment
VITE_ENVIRONMENT=development

# OAuth Configuration (for local testing)
VITE_INSTAGRAM_REDIRECT_URI=http://localhost:5173/auth/instagram/callback
VITE_CANVA_REDIRECT_URI=http://localhost:5173/auth/canva/callback

# Feature Flags
VITE_ENABLE_AUTH=true
VITE_ENABLE_OAUTH=true
VITE_ENABLE_DEBUG_LOGS=true

# App Configuration
VITE_APP_NAME=No Code Sutra (Dev)
VITE_APP_VERSION=1.0.0-dev
