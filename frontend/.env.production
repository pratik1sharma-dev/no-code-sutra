# Production Environment (Vercel)
VITE_API_BASE_URL=https://no-code-sutra-production.up.railway.app
VITE_API_TIMEOUT=30000

# Environment
VITE_ENVIRONMENT=production

# OAuth Configuration
VITE_INSTAGRAM_REDIRECT_URI=https://no-code-sutra.vercel.app/auth/instagram/callback
VITE_CANVA_REDIRECT_URI=https://no-code-sutra.vercel.app/auth/canva/callback

# Feature Flags
VITE_ENABLE_AUTH=true
VITE_ENABLE_OAUTH=true
VITE_ENABLE_DEBUG_LOGS=false

# App Configuration
VITE_APP_NAME=No Code Sutra
VITE_APP_VERSION=1.0.0
